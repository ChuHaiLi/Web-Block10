generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PhotoStatus {
  PUBLISHED
  DELETING
  PURGED
}

model User {
  id                String    @id
  username          String    @unique @db.VarChar(30)
  passwordHash      String
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime?
  passwordChangedAt DateTime  @default(now())
  createdAt         DateTime  @default(now())
  photos            Photo[]
  sessions          Session[]
}

model Session {
  sid       String   @id
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      String
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

model Photo {
  id             String         @id
  ownerId        String
  owner          User           @relation(fields: [ownerId], references: [id])
  title          String         @db.VarChar(120)
  alt            String         @db.VarChar(250)
  originalKey    String         @unique
  originalWidth  Int
  originalHeight Int
  status         PhotoStatus    @default(PUBLISHED)
  currentVersion Int            @default(1)
  nextVersion    Int            @default(2)
  createdAt      DateTime       @default(now())
  deletedAt      DateTime?
  purgedAt       DateTime?
  versions       PhotoVersion[]
  variants       PhotoVariant[]

  @@index([status, createdAt])
  @@index([ownerId, status, createdAt])
}

model PhotoVersion {
  photoId      String
  version      Int
  edits        Json
  width        Int
  height       Int
  createdAt    DateTime       @default(now())
  supersededAt DateTime?
  purgedAt     DateTime?
  photo        Photo          @relation(fields: [photoId], references: [id])
  variants     PhotoVariant[]

  @@id([photoId, version])
}

model PhotoVariant {
  id           Int          @id @default(autoincrement())
  photoId      String
  version      Int
  width        Int
  height       Int
  mime         String
  bytes        Int
  storageKey   String       @unique
  photo        Photo        @relation(fields: [photoId], references: [id])
  photoVersion PhotoVersion @relation(fields: [photoId, version], references: [photoId, version])

  @@unique([photoId, version, width])
}
