<h1>Gallery</h1>
<% if (photos.length === 0) { %>
    <p>Chưa có ảnh. <a href="/upload">Tải ảnh lên</a></p>
<% } else { %>
    <ul class="photos">
        <% for (const photo of photos) { %>
            <li id="photo-<%= photo.id %>">
                <a class="photo-card" href="/photos/<%= photo.id %>">
                    <figure>
                        <%- include('photo-image', {
                            photo,
                            sizes: '(max-width: 599px) 100vw, (max-width: 999px) 50vw, 33vw',
                            loading: 'lazy'
                        }) %>
                        <figcaption><%= photo.title %></figcaption>
                    </figure>
                </a>
            </li>
        <% } %>
    </ul>
<% } %>
