<h1>Gallery</h1>
<% if (photos.length === 0) { %>
    <p>Chưa có ảnh. <a href="/upload">Tải ảnh lên</a></p>
<% } else { %>
    <ul class="photos">
        <% for (const { id, title, alt, cover } of photos) { %>
            <li id="photo-<%= id %>">
                <figure>
                    <img src="/media/<%= cover.storageKey %>" width="<%= cover.width %>"
                         height="<%= cover.height %>" loading="lazy" decoding="async" alt="<%= alt %>">
                    <figcaption><%= title %></figcaption>
                </figure>
            </li>
        <% } %>
    </ul>
<% } %>
