<h1><%= title %></h1>
<% if (photos.length === 0) { %>
    <p><%= myPhotos ? 'Bạn chưa đăng ảnh nào' : 'Chưa có ảnh.' %> <a href="/upload">Tải ảnh lên</a></p>
<% } else { %>
    <ul class="photos">
        <% for (const photo of photos) { %>
            <li id="photo-<%= photo.id %>">
                <a class="photo-card" href="/photos/<%= photo.id %>">
                    <figure>
                        <%- include('photo-image', {
                            photo,
                            sizes: '(max-width: 599px) 100vw, (max-width: 999px) 50vw, 33vw',
                            loading: 'lazy'
                        }) %>
                        <figcaption>
                            <%= photo.title %>
                            <span class="photo-author">Đăng bởi <%= photo.owner.username %></span>
                        </figcaption>
                    </figure>
                </a>
            </li>
        <% } %>
    </ul>
<% } %>
