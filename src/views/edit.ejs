<article class="photo-editor">
    <p><a class="back-link" href="/photos/<%= photo.id %>">← Quay lại ảnh</a></p>
    <h1 class="section-title">Chỉnh sửa ảnh</h1>
    <p class="edit-title"><%= photo.title %></p>

    <form id="edit-form" action="/api/photos/<%= photo.id %>/edits"
          data-detail="/photos/<%= photo.id %>" data-source="/photos/<%= photo.id %>/edit/source"
          data-initial="<%= JSON.stringify(initial) %>">
        <fieldset id="edit-controls" disabled>
            <legend>Chỉnh sửa</legend>
            <div class="edit-buttons">
                <button id="rotate-left" type="button"><svg class="btn-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7"></path><path d="M3 4v5h5"></path></svg> Xoay trái</button>
                <button id="rotate-right" type="button"><svg class="btn-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7"></path><path d="M21 4v5h-5"></path></svg> Xoay phải</button>
                <label class="edit-checkbox"><input id="flip-horizontal" type="checkbox"<% if (initial.edits.flipH) { %> checked<% } %>> <svg class="btn-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v18"></path><path d="M8 7L3 17h5z"></path><path d="M16 7l5 10h-5z"></path></svg> Lật ngang</label>
                <button id="clear-crop" type="button"><svg class="btn-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2v14a2 2 0 0 0 2 2h14"></path><path d="M2 6h14a2 2 0 0 1 2 2v14"></path><path d="M3 3l18 18"></path></svg> Bỏ crop</button>
            </div>
            <p id="crop-hint">Kéo trên ảnh hoặc chạm lần lượt vào hai góc đối diện để chọn vùng giữ lại.</p>
            <div id="crop-stage" class="crop-stage" hidden>
                <canvas id="edit-canvas" role="img" aria-label="<%= photo.alt %>" aria-describedby="crop-hint"></canvas>
                <span id="crop-outline" class="crop-outline" aria-hidden="true" hidden></span>
            </div>
            <figure id="crop-preview" class="crop-preview" hidden>
                <figcaption>Xem trước vùng crop</figcaption>
                <canvas id="crop-canvas" role="img" aria-label="<%= photo.alt %>"></canvas>
            </figure>
            <div class="edit-buttons edit-actions">
                <button class="edit-primary" type="submit">Lưu</button>
                <button id="restore-photo" class="edit-secondary" type="button">Khôi phục</button>
            </div>
        </fieldset>
        <p id="edit-status" role="status">Đang tải ảnh…</p>
        <p id="edit-error" role="alert"></p>
        <button id="reload-edit" type="button" hidden>Tải lại trang</button>
    </form>
    <noscript>Trang chỉnh sửa cần JavaScript.</noscript>
</article>
<script src="/edit.js" defer></script>
