<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %> | Photo Gallery</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <header class="site-header">
        <span class="site-name">Photo Gallery</span>
        <nav aria-label="Điều hướng chính">
            <a href="/"<% if (page === 'gallery') { %> aria-current="page"<% } %>>Gallery</a>
            <a href="/upload"<% if (page === 'upload') { %> aria-current="page"<% } %>>Upload</a>
        </nav>
    </header>
    <main>
        <%- include(page) %>
    </main>
</body>
</html>
