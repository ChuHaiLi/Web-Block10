<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %> | Photo Gallery</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <header class="site-header">
        <span class="site-name">Photo Gallery</span>
        <nav aria-label="Điều hướng chính">
            <a href="/"<% if (page === 'gallery') { %> aria-current="page"<% } %>>Gallery</a>
            <% if (user) { %>
                <a href="/upload"<% if (page === 'upload') { %> aria-current="page"<% } %>>Upload</a>
                <span class="site-user"><%= user.username %></span>
                <form method="post" action="/logout">
                    <button type="submit">Đăng xuất</button>
                </form>
            <% } else { %>
                <a href="/login"<% if (page === 'auth' && action === '/login') { %> aria-current="page"<% } %>>Đăng nhập</a>
                <a href="/register"<% if (page === 'auth' && action === '/register') { %> aria-current="page"<% } %>>Đăng ký</a>
            <% } %>
        </nav>
    </header>
    <main>
        <%- include(page) %>
    </main>
</body>
</html>
