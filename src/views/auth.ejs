<section class="card auth-card">
    <h1><%= title %></h1>
    <form class="auth-form" method="post" action="<%= action %>">
        <input type="hidden" name="next" value="<%= nextPath %>">
        <label for="username">Tên đăng nhập</label>
        <input id="username" name="username" value="<%= username %>" autocomplete="username"<% if (error) { %> aria-describedby="auth-error"<% } %> required>

        <label for="password">Mật khẩu</label>
        <input id="password" name="password" type="password" maxlength="128"
               autocomplete="<%= registering ? 'new-password' : 'current-password' %>"<% if (error) { %> aria-describedby="auth-error"<% } %> required>
        <% if (registering) { %>
            <label for="password-confirm">Nhập lại mật khẩu</label>
            <input id="password-confirm" name="passwordConfirm" type="password" maxlength="128" autocomplete="new-password"<% if (error) { %> aria-describedby="auth-error"<% } %> required>
        <% } %>
        <% if (error) { %>
            <p id="auth-error" class="auth-error" role="alert"><%= error %></p>
        <% } %>
        <button type="submit"><%= title %></button>
    </form>
</section>
